# 本地后端代理配置。复制为 .env 后填写；.env 不会提交到仓库。
PORT=8787
HOST=127.0.0.1
# mock | openai | fal
AI_PROVIDER=mock

# OpenAI Images API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
# 体检报告 PDF/图片解析使用的视觉模型
OPENAI_REPORT_MODEL=gpt-4.1-mini

# fal.ai（默认使用 FLUX img2img）
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev/image-to-image

# 生产环境静态托管 dist 时设为 true
SERVE_STATIC=false
# 生产环境跨域来源，多个用逗号分隔
CORS_ORIGIN=
